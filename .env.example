# Salin file ini menjadi .env.local lalu isi nilainya (untuk jalan di komputer sendiri).
# Di Vercel, isi variabel yang sama lewat Settings > Environment Variables.
# JANGAN menulis password asli di file .env.example ini, karena file ini ikut ke GitHub.

# Alamat rahasia admin. Admin hanya bisa dibuka di https://situs-anda.com/<nilai ini>.
# Alamat lain, termasuk /admin dan /login, tampil 404 seperti halaman yang tidak ada.
# Isi dengan 8 sampai 64 huruf, angka, tanda - atau _. Contoh: masuk-k7x2q9m4
# Jika dikosongkan, admin mati total.
ADMIN_PATH=

# Login admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Kunci untuk menandatangani sesi login (minimal 32 karakter acak).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# OPSIONAL. Batasi admin hanya untuk IP tertentu, dipisah koma. Kosongkan jika tidak dipakai.
# Hati-hati: kalau IP internet Anda berubah-ubah, Anda bisa terkunci dari admin sendiri.
ALLOWED_IPS=

# Diisi otomatis oleh Vercel saat Blob store dihubungkan ke project.
# Kosongkan saat uji coba di komputer sendiri: situs akan memakai mode lokal.
BLOB_READ_WRITE_TOKEN=
